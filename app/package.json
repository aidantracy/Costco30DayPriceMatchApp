{
  "name": "price-match-tracker-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.17",
    "expo-dev-client": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/__fixtures__/**",
      "!src/**/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "lines": 90
      }
    }
  }
