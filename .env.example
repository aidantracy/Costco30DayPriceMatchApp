# Copy to .env and fill in real values locally. Never commit .env.
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///local.db

# Inbound email (forwarded Costco.com order confirmations)
INBOUND_EMAIL_ADDRESS=imports@example.com
INBOUND_WEBHOOK_SECRET=change-me

# Outbound alerts
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
ALERT_FROM_ADDRESS=alerts@example.com

# Business rules (see docs/project-charter.md#business-rules)
PRICE_ADJUSTMENT_WINDOW_DAYS=30
