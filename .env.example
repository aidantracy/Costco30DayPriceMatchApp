# Copy to .env and fill in real values locally. Never commit .env.
# In production these come from Google Secret Manager (see docs/design/architecture.md#6-configuration).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/pricematch
TOKEN_SIGNING_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Notifications
EXPO_ACCESS_TOKEN=change-me
EMAIL_API_KEY=change-me
ALERT_FROM_ADDRESS=alerts@example.com

# Business rules (see docs/project-charter.md#business-rules)
PRICE_ADJUSTMENT_WINDOW_DAYS=30
REMINDER_LEAD_DAYS=3

# Automation limits (personal use only, see docs/project-charter.md#terms-of-use)
HEALTH_FAILURE_THRESHOLD=3
SYNC_MIN_INTERVAL_MINUTES=60
PRICE_CHECK_MAX_PER_ITEM_PER_DAY=1
PRICE_CHECK_ALLOWED_HOSTS=www.costco.com
